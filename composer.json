{
  "name": "wishbox/cdek-library",
  "description": "PHP library for working with CDEK-related functionality.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "WishboxCdek\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^2.0",
    "ext-ctype": "*",
    "ext-simplexml": "*",
    "ext-http": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "guzzlehttp/guzzle": "^7.9"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test:integration": "phpunit --configuration phpunit.integration.xml",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
