{
    "name":  "wishbox/cdek-library",
    "version":  "0.1.0",
    "description":  "PHP library for working with CDEK-related functionality.",
    "type":  "library",
    "license":  "MIT",
    "autoload":  {
                     "psr-4":  {
                                   "WishboxCdek\\":  "src/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/"
                                   }
                     },
    "require":  {
                    "php":  "^8.4",
                    "psr/http-client":  "^1.0",
                    "psr/http-factory":  "^1.0",
                    "psr/http-message":  "^2.0"
                },
    "require-dev":  {
                        "phpunit/phpunit":  "^11.5",
                        "guzzlehttp/guzzle":  "^7.9"
                    },
    "scripts":  {
                    "test":  "phpunit --configuration phpunit.xml",
                    "test:integration":  "phpunit --configuration phpunit.integration.xml",
                    "lint":  "php -l src/CdekClient.php"
                },
    "minimum-stability":  "stable",
    "prefer-stable":  true
}
